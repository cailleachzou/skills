# Python
__pycache__/
*.py[cod]
*$py.class

# Node
node_modules/

# 本地 Slidev 项目（符号链接到 .agents/skills/slidev，非 skill）
slidev/

# umi-ocr 源码子仓库（独立 .git，非本仓库内容）
umi-ocr-src/

# Claude Code 本地配置（每个 skill 下若有 .claude/settings.local.json）
.claude/settings.local.json
**/.claude/settings.local.json

# npx skills 默认会装到 CWD/.agents/，避免污染仓库
**/.agents/

# npx skills 生成的本地锁文件（含已安装 skill 哈希）
skills-lock.json

# OCR 本地测试草稿（大体积测试 PDF 与转换输出）
cli-anything/sub-skills/ocr/test/

# mimo-cli 运行时目录（插件依赖 + cron 锁文件，非本仓库内容）
.mimocode/

