    </w:p>
    <w:p w:rsidR="009E70B2" w:rsidRDefault="00000000" w14:paraId="62712B97" w14:textId="77777777">
      <w:pPr>
        <w:pStyle w:val="FirstParagraph"/>
        <w:ind w:firstLine="400"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rFonts w:hint="eastAsia"/>
        </w:rPr>
        <w:t>自然语言处理、计算机视觉等交互技术使用户能够以更直观的方式与系统沟通，包括语音控制、手势识别等。</w:t>
      </w:r>
    </w:p>
